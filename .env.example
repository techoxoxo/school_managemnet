# ── API ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0

# ── Database (docker-compose defaults) ───────────────
# Admin/migration connection (superuser — bypasses RLS). Host port 5433 (5432 taken by native PG).
DATABASE_URL=postgres://schoolmate:schoolmate_dev@localhost:5433/schoolmate
# Application connection (non-superuser — RLS ENFORCED; the API must use this one)
DATABASE_APP_URL=postgres://schoolmate_app:schoolmate_app_dev@localhost:5433/schoolmate

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO dev) ───────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=schoolmate
S3_SECRET_KEY=schoolmate_dev
S3_BUCKET=schoolmate-dev

# ── Search ───────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=schoolmate_dev_master_key

# ── Email (mailpit dev) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Payment gateway (Razorpay — P2-MOD-08) ───────────
# Leave empty for "manual" mode (local orders, no live gateway calls, webhook
# disabled). Fill with sandbox creds to enable real orders + webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Auth (set real secrets outside dev) ──────────────
JWT_SECRET=dev_only_change_me
