# ── API ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0

# ── Database (docker-compose defaults) ───────────────
DATABASE_URL=postgres://schoolmate:schoolmate_dev@localhost:5432/schoolmate

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO dev) ───────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=schoolmate
S3_SECRET_KEY=schoolmate_dev
S3_BUCKET=schoolmate-dev

# ── Search ───────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=schoolmate_dev_master_key

# ── Email (mailpit dev) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Auth (set real secrets outside dev) ──────────────
JWT_SECRET=dev_only_change_me
